#!/usr/bin/env bash
# Runs trmnlp from the local Ruby gem when it is installed, otherwise falls
# back to the official Docker image. Usage: bin/trmnlp serve | push | lint
set -euo pipefail

if command -v trmnlp >/dev/null 2>&1; then
  exec trmnlp "$@"
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "Neither the trmnlp gem nor docker is installed." >&2
  echo "Install one:  gem install trmnl_preview   |   https://docs.docker.com/get-docker/" >&2
  exit 1
fi

exec docker run --rm -it \
  -v "$PWD:/plugin" \
  -p 4567:4567 \
  -e TRMNL_API_KEY \
  trmnl/trmnlp "$@"
