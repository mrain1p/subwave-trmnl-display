{%- comment -%} ══ SUB/WAVE RADIO · full ══ {%- endcomment -%}
{% assign cf = trmnl.plugin_settings.custom_fields_values %}
{% assign station_url  = cf.station_url  | default: station_url %}
{% assign station_name = cf.station_name | default: station_name %}
{% assign subtitle     = cf.subtitle     | default: subtitle %}
{% assign tz_offset    = cf.tz_offset    | default: tz_offset %}
{% assign show_avatars = cf.show_avatars | default: show_avatars | default: 'yes' %}
{% assign guide_rows   = cf.guide_rows   | default: guide_rows %}
{% assign title_bar    = cf.title_bar    | default: title_bar | default: 'no' %}
{% assign topic_size   = cf.topic_size   | default: topic_size | default: 'md' %}

{%- comment -%} description size + how many lines survive the clamp {%- endcomment -%}
{% case topic_size %}
  {% when 'lg' %}{% assign t_cls = 'description description--large' %}{% assign t_clamp = 8 %}{% assign t_clamp_p = 4 %}
  {% when 'sm' %}{% assign t_cls = 'description text--small' %}{% assign t_clamp = 14 %}{% assign t_clamp_p = 7 %}
  {% else %}{% assign t_cls = 'description' %}{% assign t_clamp = 11 %}{% assign t_clamp_p = 5 %}
{% endcase %}

{%- comment -%} DJ artwork treatment {%- endcomment -%}
{% assign av_on = true %}
{% assign av_extra = '' %}
{% case show_avatars %}
  {% when 'no' %}{% assign av_on = false %}
  {% when 'outline' %}{% assign av_extra = 'image-stroke image-stroke--black image-stroke--small' %}
  {% when 'contrast' %}{% assign av_extra = 'sw-contrast' %}
{% endcase %}

{% assign shows_l    = IDX_0.shows    | default: shows %}
{% assign personas_l = IDX_0.personas | default: personas %}
{% assign grid       = IDX_0.schedule | default: schedule %}
{% assign np         = IDX_1 %}

{% assign host = station_url | strip | remove: "https://" | remove: "http://" | split: "/" | first %}
{% assign base = "https://" | append: host | append: "/api" %}

{% assign st_name = station_name | strip %}
{% if st_name == blank %}{% assign st_name = np.dj.station %}{% endif %}
{% if st_name == blank %}{% assign st_name = "SUB/WAVE" %}{% endif %}
{% assign st_tag = subtitle | strip %}
{% if st_tag == blank %}{% assign st_tag = np.dj.tagline %}{% endif %}
{% if st_tag == blank %}{% assign st_tag = host %}{% endif %}

{% assign off_s = trmnl.user.utc_offset %}
{% if tz_offset != blank %}{% assign off_s = tz_offset | times: 3600 %}{% endif %}
{% assign local_ts = trmnl.system.timestamp_utc | plus: off_s %}
{% assign dow = local_ts | date: '%w' %}
{% assign hour_now = local_ts | date: '%H' | plus: 0 %}
{% assign max_rows = guide_rows | default: 10 | plus: 0 %}

{% assign today = grid[dow] %}
{% assign dow_n = dow | plus: 0 %}
{% assign tm_key = dow_n | plus: 1 | modulo: 7 | append: "" %}
{% assign tomorrow = grid[tm_key] %}
{% assign current_id = today[hour_now] %}

{% assign cur_start = 0 %}
{% for h in (0..hour_now) %}
  {% if today[h] != current_id %}{% assign cur_start = h | plus: 1 %}{% endif %}
{% endfor %}
{% assign cur_end = 24 %}
{% assign found = false %}
{% for h in (hour_now..23) %}
  {% unless found %}
    {% if today[h] != current_id %}{% assign cur_end = h %}{% assign found = true %}{% endif %}
  {% endunless %}
{% endfor %}

{% assign tm_skip = 0 %}
{% assign end_hour = cur_end %}
{% assign next_id = nil %}
{% assign next_start = 0 %}
{% if cur_end < 24 %}
  {% assign next_id = today[cur_end] %}
  {% assign next_start = cur_end %}
{% else %}
  {% if tomorrow[0] == current_id %}
    {% assign tm_end = 24 %}
    {% assign found3 = false %}
    {% for h in (0..23) %}
      {% unless found3 %}
        {% if tomorrow[h] != current_id %}{% assign tm_end = h %}{% assign found3 = true %}{% endif %}
      {% endunless %}
    {% endfor %}
    {% assign end_hour = tm_end %}
    {% assign tm_skip = tm_end %}
    {% assign next_id = tomorrow[tm_end] %}
    {% assign next_start = tm_end %}
  {% else %}
    {% assign found2 = false %}
    {% for h in (0..23) %}
      {% unless found2 %}
        {% if tomorrow[h] != current_id %}
          {% assign next_id = tomorrow[h] %}
          {% assign next_start = h %}
          {% assign found2 = true %}
        {% endif %}
      {% endunless %}
    {% endfor %}
  {% endif %}
{% endif %}

{% capture cur_start_f %}{% assign x = cur_start | modulo: 12 %}{% if x == 0 %}12{% else %}{{ x }}{% endif %}{% if cur_start >= 12 %}PM{% else %}AM{% endif %}{% endcapture %}
{% assign ce = end_hour | modulo: 24 %}
{% capture cur_end_f %}{% assign x = ce | modulo: 12 %}{% if x == 0 %}12{% else %}{{ x }}{% endif %}{% if ce >= 12 %}PM{% else %}AM{% endif %}{% endcapture %}
{% capture next_start_f %}{% assign x = next_start | modulo: 12 %}{% if x == 0 %}12{% else %}{{ x }}{% endif %}{% if next_start >= 12 %}PM{% else %}AM{% endif %}{% endcapture %}

<style>
  /* No Framework utility exists for filters; defined once as a class so no
     element carries an inline style attribute. */
  .sw-contrast { filter: grayscale(1) contrast(1.75) brightness(1.04); }
</style>
{% if title_bar == 'yes' %}
  <div class="title_bar">
    <span class="title">{{ st_name }}</span>
    <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
  </div>
{% endif %}
<div class="layout">
  <div class="flex flex--row portrait:flex--col h--full">

    <div class="flex flex--col gap--small w--[54cqw] portrait:w--full pr--2 portrait:pr--0">

      <div class="flex flex--col">
        <div class="flex flex--center-x">
          <span class="title portrait:title--small" data-clamp="1">{{ st_name | upcase }}</span>
        </div>
        <div class="divider"></div>
        <div class="flex flex--center-x py--0.5">
          <span class="label label--small" data-clamp="1">{{ st_tag | upcase }} &middot; {{ local_ts | date: '%a, %b %-d' | upcase }}</span>
        </div>
        <div class="divider"></div>
      </div>

      {% assign on_air = shows_l | find_by: 'id', current_id %}
      {% if on_air %}
        {% assign dj = personas_l | find_by: 'id', on_air.personaId %}
        <div class="flex flex--row gap--small flex--center-y">
          {% if av_on and dj.avatar %}
            {% if dj.avatar contains '://' %}{% assign av = dj.avatar %}{% else %}{% assign av = base | append: dj.avatar %}{% endif %}
            <img class="image image-dither image--cover {{ av_extra }} w--[88px] h--[88px] shrink-0" src="{{ av }}" />
          {% endif %}
          <div class="flex flex--col gap--xsmall">
            <span class="label label--small label--filled self--start">&#9679; ON AIR &middot; {{ cur_start_f }}&ndash;{{ cur_end_f }}</span>
            <span class="title title--small" data-clamp="2">{{ on_air.name }}</span>
            {% if dj.name %}<span class="label label--small" data-clamp="1">WITH {{ dj.name | upcase }}</span>{% endif %}
          </div>
        </div>

        <div class="divider"></div>
        <div class="grow">
          <span class="{{ t_cls }}" data-clamp="{{ t_clamp }}" data-clamp-portrait="{{ t_clamp_p }}">{{ on_air.topic }}</span>
        </div>
      {% else %}
        <div class="grow flex flex--col flex--center gap--small">
          <span class="label label--small label--filled self--start">UNSCHEDULED</span>
          <span class="description text--center">Rotation is running unattended right now.</span>
        </div>
      {% endif %}

      {% assign up_next = shows_l | find_by: 'id', next_id %}
      {% if up_next %}
        {% assign ndj = personas_l | find_by: 'id', up_next.personaId %}
        <div class="divider"></div>
        <div class="flex flex--row gap--small flex--center-y">
          {% if av_on and ndj.avatar %}
            {% if ndj.avatar contains '://' %}{% assign nav = ndj.avatar %}{% else %}{% assign nav = base | append: ndj.avatar %}{% endif %}
            <img class="image image-dither image--cover {{ av_extra }} w--[52px] h--[52px] shrink-0" src="{{ nav }}" />
          {% endif %}
          <div class="flex flex--col gap--xsmall">
            <span class="label label--small label--outline self--start">COMING UP &middot; {{ next_start_f }}</span>
            <span class="title title--small" data-clamp="1">{{ up_next.name }}</span>
            {% if ndj.name %}<span class="description" data-clamp="1">with {{ ndj.name }}</span>{% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    <div class="divider--v portrait:hidden"></div>

    <div class="flex flex--col grow pl--2 portrait:pl--0">
      <span class="label label--small">PROGRAMMING GUIDE</span>
      <div class="divider"></div>

      <div class="flex flex--col grow gap--xsmall" data-overflow="true">
        {% assign rows = 0 %}
        {% assign tm_from = tm_skip %}

        {% for h in (cur_start..23) %}
          {% if rows < max_rows %}
            {% assign id_h = today[h] %}
            {% if id_h %}
              {% assign is_start = false %}
              {% if h == cur_start %}
                {% assign is_start = true %}
              {% else %}
                {% assign hp = h | minus: 1 %}
                {% if today[hp] != id_h %}{% assign is_start = true %}{% endif %}
              {% endif %}

              {% if is_start %}
                {% if h == cur_start %}
                  {% assign b_end = end_hour %}
                {% else %}
                  {% assign b_end = 24 %}
                  {% assign done = false %}
                  {% for h2 in (h..23) %}
                    {% unless done %}
                      {% if today[h2] != id_h %}{% assign b_end = h2 %}{% assign done = true %}{% endif %}
                    {% endunless %}
                  {% endfor %}
                {% endif %}
                {% if b_end == 24 and h != cur_start and tomorrow[0] == id_h %}
                  {% assign tm_end2 = 24 %}
                  {% assign done2 = false %}
                  {% for h2 in (0..23) %}
                    {% unless done2 %}
                      {% if tomorrow[h2] != id_h %}{% assign tm_end2 = h2 %}{% assign done2 = true %}{% endif %}
                    {% endunless %}
                  {% endfor %}
                  {% assign b_end = tm_end2 %}
                  {% assign tm_from = tm_end2 %}
                {% endif %}
                {% capture t1 %}{% assign x = h | modulo: 12 %}{% if x == 0 %}12{% else %}{{ x }}{% endif %}{% if h >= 12 %}PM{% else %}AM{% endif %}{% endcapture %}
                {% assign be = b_end | modulo: 24 %}
                {% capture t2 %}{% assign x = be | modulo: 12 %}{% if x == 0 %}12{% else %}{{ x }}{% endif %}{% if be >= 12 %}PM{% else %}AM{% endif %}{% endcapture %}

                {% assign gs = shows_l | find_by: 'id', id_h %}
                {% if gs %}
                  {% assign short_name = gs.name | split: " ·" | first %}
                  {% assign gdj = personas_l | find_by: 'id', gs.personaId %}
                  {% if h == cur_start %}
                    <div class="flex flex--row gap--small bg--black rounded--xsmall px--1.5 py--1 shrink-0">
                      <span class="label label--small value--tnums text--white w--[84px] shrink-0">{{ t1 }}&ndash;{{ t2 }}</span>
                      <div class="flex flex--col">
                        <span class="title title--small text--white" data-clamp="1">&#9654; {{ short_name }}</span>
                        {% if gdj.name %}<span class="description text--white" data-clamp="1">with {{ gdj.name }}</span>{% endif %}
                      </div>
                    </div>
                  {% else %}
                    <div class="flex flex--row gap--small px--1.5 shrink-0">
                      <span class="label label--small value--tnums w--[84px] shrink-0">{{ t1 }}&ndash;{{ t2 }}</span>
                      <div class="flex flex--col">
                        <span class="title title--small" data-clamp="1">{{ short_name }}</span>
                        {% if gdj.name %}<span class="description" data-clamp="1">with {{ gdj.name }}</span>{% endif %}
                      </div>
                    </div>
                    <div class="divider"></div>
                  {% endif %}
                  {% assign rows = rows | plus: 1 %}
                {% endif %}
              {% endif %}
            {% endif %}
          {% endif %}
        {% endfor %}

        {% if rows < max_rows %}
          {% for h in (tm_from..23) %}
            {% if rows < max_rows %}
              {% assign id_h = tomorrow[h] %}
              {% if id_h %}
                {% assign is_start = false %}
                {% if h == tm_from %}
                  {% assign is_start = true %}
                {% else %}
                  {% assign hp = h | minus: 1 %}
                  {% if tomorrow[hp] != id_h %}{% assign is_start = true %}{% endif %}
                {% endif %}

                {% if is_start %}
                  {% assign b_end = 24 %}
                  {% assign done = false %}
                  {% for h2 in (h..23) %}
                    {% unless done %}
                      {% if tomorrow[h2] != id_h %}{% assign b_end = h2 %}{% assign done = true %}{% endif %}
                    {% endunless %}
                  {% endfor %}
                  {% capture t1 %}{% assign x = h | modulo: 12 %}{% if x == 0 %}12{% else %}{{ x }}{% endif %}{% if h >= 12 %}PM{% else %}AM{% endif %}{% endcapture %}
                  {% assign be = b_end | modulo: 24 %}
                  {% capture t2 %}{% assign x = be | modulo: 12 %}{% if x == 0 %}12{% else %}{{ x }}{% endif %}{% if be >= 12 %}PM{% else %}AM{% endif %}{% endcapture %}

                  {% assign gs = shows_l | find_by: 'id', id_h %}
                  {% if gs %}
                    {% assign short_name = gs.name | split: " ·" | first %}
                    {% assign gdj = personas_l | find_by: 'id', gs.personaId %}
                    <div class="flex flex--row gap--small px--1.5 shrink-0">
                      <span class="label label--small value--tnums w--[84px] shrink-0">{{ t1 }}&ndash;{{ t2 }}</span>
                      <div class="flex flex--col">
                        <span class="title title--small" data-clamp="1">{{ short_name }}</span>
                        {% if gdj.name %}<span class="description" data-clamp="1">with {{ gdj.name }}</span>{% endif %}
                      </div>
                    </div>
                    <div class="divider"></div>
                    {% assign rows = rows | plus: 1 %}
                  {% endif %}
                {% endif %}
              {% endif %}
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
    </div>

  </div>
</div>
